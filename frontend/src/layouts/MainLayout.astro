---
/**
 * 主布局组件
 * 定义 HTML 文档结构，包含 head 标签、全局样式、字体引入
 * 包含 Header 导航和 Footer 页脚
 * 中间通过 slot 插入各板块内容
 */

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '秦腔 - 中国非物质文化遗产 | 国潮科普',
  description = '以现代国潮视觉设计展示中国非物质文化遗产秦腔的历史、行当、名家名段及服饰脸谱艺术。通俗易懂的图文视听科普，带您领略大秦之腔的独特魅力。',
} = Astro.props;

import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/600.css';
import '@fontsource/noto-serif-sc/700.css';
import '@fontsource/zcool-xiaowei/400.css';
import '../styles/global.css';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#C41A1A" />
    <meta name="color-scheme" content="light" />

    <!-- Open Graph 社交分享元数据 -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content="/assets/images/hero/og-cover.svg" />

    <!-- 网站图标 -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>

    <!-- 预连接到外部资源 -->
    <link rel="preconnect" href="https://player.bilibili.com" crossorigin />
  </head>

  <body class="min-h-screen flex flex-col">
    <!-- 顶部导航栏 -->
    <header id="site-header">
      <nav class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
           id="main-nav"
           role="navigation"
           aria-label="主导航">
        <div class="container-custom">
          <div class="flex items-center justify-between h-16">
            <!-- Logo / 网站名称 -->
            <a href="#hero"
               class="flex items-center gap-2 font-display text-xl md:text-2xl text-china-red-500 hover:text-china-red-600 transition-colors"
               aria-label="回到顶部">
              <span class="text-3xl">🎭</span>
              <span class="hidden xs:inline">秦腔文化</span>
            </a>

            <!-- 桌面端导航链接 -->
            <ul class="hidden md:flex items-center gap-6 lg:gap-8 font-body text-sm lg:text-base">
              <li>
                <a href="#history"
                   class="nav-link text-ink-600 hover:text-china-red-500 transition-colors py-2 relative
                          after:content-[''] after:absolute after:bottom-0 after:left-1/2 after:-translate-x-1/2
                          after:w-0 after:h-0.5 after:bg-china-red-500 after:transition-all after:duration-300
                          hover:after:w-full"
                   data-nav="history">
                  历史起源
                </a>
              </li>
              <li>
                <a href="#roles"
                   class="nav-link text-ink-600 hover:text-china-red-500 transition-colors py-2 relative
                          after:content-[''] after:absolute after:bottom-0 after:left-1/2 after:-translate-x-1/2
                          after:w-0 after:h-0.5 after:bg-china-red-500 after:transition-all after:duration-300
                          hover:after:w-full"
                   data-nav="roles">
                  行当分类
                </a>
              </li>
              <li>
                <a href="#gallery"
                   class="nav-link text-ink-600 hover:text-china-red-500 transition-colors py-2 relative
                          after:content-[''] after:absolute after:bottom-0 after:left-1/2 after:-translate-x-1/2
                          after:w-0 after:h-0.5 after:bg-china-red-500 after:transition-all after:duration-300
                          hover:after:w-full"
                   data-nav="gallery">
                  脸谱与服饰
                </a>
              </li>
              <li>
                <a href="#artists"
                   class="nav-link text-ink-600 hover:text-china-red-500 transition-colors py-2 relative
                          after:content-[''] after:absolute after:bottom-0 after:left-1/2 after:-translate-x-1/2
                          after:w-0 after:h-0.5 after:bg-china-red-500 after:transition-all after:duration-300
                          hover:after:w-full"
                   data-nav="artists">
                  名家名段
                </a>
              </li>
              <li>
                <a href="#media"
                   class="nav-link text-ink-600 hover:text-china-red-500 transition-colors py-2 relative
                          after:content-[''] after:absolute after:bottom-0 after:left-1/2 after:-translate-x-1/2
                          after:w-0 after:h-0.5 after:bg-china-red-500 after:transition-all after:duration-300
                          hover:after:w-full"
                   data-nav="media">
                  视听体验
                </a>
              </li>
            </ul>

            <!-- 移动端菜单按钮 -->
            <button
              class="md:hidden p-2 text-ink-600 hover:text-china-red-500 transition-colors"
              id="mobile-menu-btn"
              aria-label="打开导航菜单"
              aria-expanded="false"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
          </div>
        </div>

        <!-- 移动端下拉菜单 -->
        <div id="mobile-menu" class="md:hidden hidden bg-white/95 backdrop-blur-md border-t border-rice-paper-300 shadow-lg">
          <div class="container-custom py-4">
            <ul class="space-y-2">
              <li>
                <a href="#history" class="mobile-nav-link block py-3 px-4 text-ink-600 hover:text-china-red-500 hover:bg-china-red-50 rounded transition-colors" data-nav="history">
                  历史起源
                </a>
              </li>
              <li>
                <a href="#roles" class="mobile-nav-link block py-3 px-4 text-ink-600 hover:text-china-red-500 hover:bg-china-red-50 rounded transition-colors" data-nav="roles">
                  行当分类
                </a>
              </li>
              <li>
                <a href="#gallery" class="mobile-nav-link block py-3 px-4 text-ink-600 hover:text-china-red-500 hover:bg-china-red-50 rounded transition-colors" data-nav="gallery">
                  脸谱与服饰
                </a>
              </li>
              <li>
                <a href="#artists" class="mobile-nav-link block py-3 px-4 text-ink-600 hover:text-china-red-500 hover:bg-china-red-50 rounded transition-colors" data-nav="artists">
                  名家名段
                </a>
              </li>
              <li>
                <a href="#media" class="mobile-nav-link block py-3 px-4 text-ink-600 hover:text-china-red-500 hover:bg-china-red-50 rounded transition-colors" data-nav="media">
                  视听体验
                </a>
              </li>
            </ul>
          </div>
        </div>
      </nav>
    </header>

    <!-- 主内容区域 -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- 页脚 -->
    <footer class="bg-ink-800 text-rice-paper-300 py-12 md:py-16">
      <div class="container-custom">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
          <!-- 网站简介 -->
          <div>
            <div class="flex items-center gap-2 mb-4">
              <span class="text-2xl">🎭</span>
              <span class="font-display text-xl text-white">秦腔文化</span>
            </div>
            <p class="text-sm text-rice-paper-400 leading-relaxed">
              以现代国潮视觉设计展示中国非物质文化遗产秦腔，
              致力于用通俗易懂的方式传承和推广这一古老艺术。
            </p>
          </div>

          <!-- 快速导航 -->
          <div>
            <h3 class="font-display text-lg text-white mb-4">快速导航</h3>
            <ul class="space-y-2">
              <li><a href="#history" class="text-sm text-rice-paper-400 hover:text-gold-400 transition-colors">历史起源</a></li>
              <li><a href="#roles" class="text-sm text-rice-paper-400 hover:text-gold-400 transition-colors">行当分类</a></li>
              <li><a href="#gallery" class="text-sm text-rice-paper-400 hover:text-gold-400 transition-colors">脸谱与服饰</a></li>
              <li><a href="#artists" class="text-sm text-rice-paper-400 hover:text-gold-400 transition-colors">名家名段</a></li>
              <li><a href="#media" class="text-sm text-rice-paper-400 hover:text-gold-400 transition-colors">视听体验</a></li>
            </ul>
          </div>

          <!-- 关于项目 -->
          <div>
            <h3 class="font-display text-lg text-white mb-4">关于项目</h3>
            <p class="text-sm text-rice-paper-400 leading-relaxed">
              秦腔于2006年被列入第一批国家级非物质文化遗产名录。
              本站为科普性质的非营利项目，旨在弘扬中华优秀传统文化。
            </p>
            <div class="mt-4 flex gap-3">
              <span class="inline-block px-3 py-1 bg-china-red-500/20 text-china-red-400 text-xs rounded-full">非物质文化遗产</span>
              <span class="inline-block px-3 py-1 bg-gold-500/20 text-gold-400 text-xs rounded-full">国潮科普</span>
            </div>
          </div>
        </div>

        <!-- 分隔线 -->
        <div class="mt-8 pt-8 border-t border-ink-700">
          <div class="flex flex-col md:flex-row items-center justify-between gap-4">
            <p class="text-xs text-rice-paper-500">
              © 2024 秦腔文化科普网站. 传承非遗，弘扬国粹.
            </p>
            <p class="text-xs text-rice-paper-500">
              内容仅供科普学习，图片版权归原作者所有.
            </p>
          </div>
        </div>
      </div>
    </footer>

    <!-- 全局脚本 -->
    <script>
      /**
       * 导航栏滚动效果
       * 滚动时为导航栏添加背景色和阴影
       */
      function initNavigation(): void {
        const nav = document.getElementById('main-nav');
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        if (!nav) return;

        // 滚动时导航栏样式变化
        window.addEventListener('scroll', () => {
          if (window.scrollY > 50) {
            nav.classList.add('bg-white/95', 'backdrop-blur-md', 'shadow-md');
          } else {
            nav.classList.remove('bg-white/95', 'backdrop-blur-md', 'shadow-md');
          }
        });

        // 移动端菜单切换
        if (mobileMenuBtn && mobileMenu) {
          mobileMenuBtn.addEventListener('click', () => {
            const isOpen = !mobileMenu.classList.contains('hidden');
            mobileMenu.classList.toggle('hidden');
            mobileMenuBtn.setAttribute('aria-expanded', String(!isOpen));
          });

          // 点击移动端导航链接后关闭菜单
          mobileMenu.querySelectorAll('.mobile-nav-link').forEach((link) => {
            link.addEventListener('click', () => {
              mobileMenu.classList.add('hidden');
              mobileMenuBtn.setAttribute('aria-expanded', 'false');
            });
          });
        }

        // 滚动时高亮当前板块对应的导航链接
        const sections = ['history', 'roles', 'gallery', 'artists', 'media'];
        const navLinks = document.querySelectorAll('.nav-link');

        function updateActiveNav(): void {
          const scrollPos = window.scrollY + 100;

          for (let i = sections.length - 1; i >= 0; i--) {
            const section = document.getElementById(sections[i]);
            if (section && section.offsetTop <= scrollPos) {
              navLinks.forEach((link) => {
                const navAttr = link.getAttribute('data-nav');
                if (navAttr === sections[i]) {
                  link.classList.add('text-china-red-500', 'font-semibold');
                } else {
                  link.classList.remove('text-china-red-500', 'font-semibold');
                }
              });
              break;
            }
          }
        }

        window.addEventListener('scroll', updateActiveNav);
        updateActiveNav();
      }

      // 初始化
      initNavigation();
      document.addEventListener('astro:page-load', initNavigation);
    </script>
  </body>
</html>