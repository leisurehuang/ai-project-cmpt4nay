---
/**
 * 名家与经典剧目板块组件
 * 接收名家剧目数据，渲染名家卡片和经典剧目列表
 * 以时间线风格展示历代名家及其代表作品
 */

interface Props {
  data: Array<{
    id: string;
    artistName: string;
    playTitle: string;
    synopsis: string;
    mediaUrl?: string;
  }>;
}

const { data } = Astro.props;
---

<!-- 板块简介 -->
<div class="max-w-3xl mx-auto text-center mb-12 md:mb-16">
  <p class="text-lg md:text-xl text-ink-500 leading-relaxed">
    秦腔历经数百年传承，涌现出一代代表演艺术大师。
    他们用精湛的技艺和满腔热忱，铸就了一段段传世经典。
  </p>
</div>

<!-- 名家剧目卡片网格 -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
  {data.map((item, index) => (
    <article
      class="card group overflow-hidden"
      style={`animation: fadeInUp 0.6s ease-out ${index * 0.1}s both;`}
    >
      <!-- 顶部装饰条 -->
      <div class="h-1.5 bg-gradient-to-r from-china-red-500 to-gold-500"></div>

      <div class="p-5 md:p-6">
        <!-- 艺术家姓名 -->
        <div class="flex items-center gap-3 mb-4">
          <div class="w-12 h-12 rounded-full bg-gradient-to-br from-china-red-400 to-gold-400
                      flex items-center justify-center text-white font-display text-lg font-bold flex-shrink-0">
            {item.artistName.charAt(0)}
          </div>
          <div>
            <h3 class="font-display text-xl text-ink-800 group-hover:text-china-red-500 transition-colors">
              {item.artistName}
            </h3>
            <span class="text-xs text-ink-400">秦腔表演艺术家</span>
          </div>
        </div>

        <!-- 剧目名称 -->
        <div class="mb-3">
          <span class="inline-block px-2.5 py-0.5 bg-gold-500/10 text-gold-700 text-xs font-medium rounded">
            经典剧目
          </span>
          <h4 class="font-display text-lg text-china-red-600 mt-2">{item.playTitle}</h4>
        </div>

        <!-- 剧情简介 -->
        <p class="text-ink-500 text-sm leading-relaxed line-clamp-5 mb-4">
          {item.synopsis}
        </p>

        <!-- 展开按钮 -->
        <button
          class="artist-expand-btn w-full text-center text-sm text-china-red-500 font-medium
                 hover:text-china-red-600 transition-colors py-2 border-t border-rice-paper-200"
          data-artist-id={item.id}
          aria-expanded="false"
        >
          <span class="btn-text">展开全文</span>
          <svg class="inline w-4 h-4 ml-1 transition-transform duration-300 btn-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- 可展开的完整剧情 -->
        <div class="artist-detail hidden mt-3 pt-3 border-t border-rice-paper-200" data-detail-id={item.id}>
          <p class="text-ink-500 text-sm leading-relaxed">{item.synopsis}</p>
          {item.mediaUrl && (
            <a
              href="#media"
              class="inline-flex items-center gap-1 mt-3 text-sm text-china-red-500 hover:text-china-red-600 transition-colors"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              前往视听体验
            </a>
          )}
        </div>
      </div>
    </article>
  ))}
</div>

<!-- 展开交互脚本 -->
<script>
  function initArtistCards(): void {
    const buttons = document.querySelectorAll('.artist-expand-btn');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.artistId;
        const detail = document.querySelector(`[data-detail-id="${id}"]`);
        const icon = btn.querySelector('.btn-icon');
        const text = btn.querySelector('.btn-text');
        const expanded = btn.getAttribute('aria-expanded') === 'true';

        if (detail) {
          if (expanded) {
            (detail as HTMLElement).classList.add('hidden');
            btn.setAttribute('aria-expanded', 'false');
            if (text) text.textContent = '展开全文';
            if (icon) icon.classList.remove('rotate-180');
          } else {
            (detail as HTMLElement).classList.remove('hidden');
            btn.setAttribute('aria-expanded', 'true');
            if (text) text.textContent = '收起全文';
            if (icon) icon.classList.add('rotate-180');
          }
        }
      });
    });
  }
  initArtistCards();
  document.addEventListener('astro:page-load', initArtistCards);
</script>
