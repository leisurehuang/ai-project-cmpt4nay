---
/**
 * 行当分类板块组件
 * 接收四大行当数据，渲染简介和角色卡片网格
 * 生、旦、净、丑四个行当以卡片形式展示
 */

interface Props {
  data: Array<{
    id: string;
    name: string;
    icon: string;
    features: string;
    representativeFigures: string;
  }>;
}

const { data } = Astro.props;

/** 行当对应的装饰色和图标 */
const roleMeta: Record<string, { color: string; bgClass: string; symbol: string }> = {
  '生': { color: 'china-red', bgClass: 'bg-china-red-500/10', symbol: '🎭' },
  '旦': { color: 'gold', bgClass: 'bg-pink-500/10', symbol: '🌸' },
  '净': { color: 'gold', bgClass: 'bg-gold-500/10', symbol: '🔥' },
  '丑': { color: 'ink', bgClass: 'bg-emerald-500/10', symbol: '😄' },
};
---

<!-- 板块简介 -->
<div class="max-w-3xl mx-auto text-center mb-12 md:mb-16">
  <p class="text-lg md:text-xl text-ink-500 leading-relaxed">
    秦腔的表演体系将角色分为四大行当——生、旦、净、丑，
    每个行当都有独特的表演程式、唱腔特色和脸谱装扮。
  </p>
</div>

<!-- 行当卡片网格 -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
  {data.map((role, index) => {
    const meta = roleMeta[role.name] || { color: 'ink', bgClass: 'bg-ink-500/10', symbol: '🎭' };
    return (
      <div
        class="card group cursor-pointer"
        style={`animation-delay: ${index * 0.1}s;`}
        data-role-card={role.id}
      >
        <!-- 顶部色块 + 图标 -->
        <div class={`relative h-40 flex items-center justify-center ${meta.bgClass} overflow-hidden`}>
          <span class="text-6xl group-hover:scale-125 transition-transform duration-500">
            {meta.symbol}
          </span>
          <!-- 悬停遮罩 -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        </div>

        <!-- 内容区 -->
        <div class="p-5 md:p-6">
          <!-- 行当名称 -->
          <h3 class="font-display text-2xl md:text-3xl text-ink-800 mb-2 text-center group-hover:text-china-red-500 transition-colors">
            {role.name}
          </h3>

          <!-- 装饰线 -->
          <div class="w-8 h-0.5 bg-gold-400 mx-auto mb-4 group-hover:w-16 transition-all duration-300"></div>

          <!-- 特点描述 -->
          <p class="text-ink-500 text-sm leading-relaxed mb-4 line-clamp-4">
            {role.features}
          </p>

          <!-- 展开按钮 -->
          <button
            class="role-expand-btn w-full text-center text-sm text-china-red-500 font-medium
                   hover:text-china-red-600 transition-colors py-2"
            data-role-id={role.id}
            aria-expanded="false"
          >
            <span class="btn-text">查看详情</span>
            <svg class="inline w-4 h-4 ml-1 transition-transform duration-300 btn-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- 可展开的详细信息 -->
          <div class="role-detail hidden mt-4 pt-4 border-t border-rice-paper-300" data-detail-id={role.id}>
            <h4 class="font-body font-bold text-ink-700 text-sm mb-2">代表人物</h4>
            <p class="text-ink-500 text-sm leading-relaxed">{role.representativeFigures}</p>
            <h4 class="font-body font-bold text-ink-700 text-sm mb-2 mt-3">完整介绍</h4>
            <p class="text-ink-500 text-sm leading-relaxed">{role.features}</p>
          </div>
        </div>
      </div>
    );
  })}
</div>

<!-- 行当卡片展开交互脚本 -->
<script>
  function initRoleCards(): void {
    const buttons = document.querySelectorAll('.role-expand-btn');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const roleId = (btn as HTMLElement).dataset.roleId;
        const detail = document.querySelector(`[data-detail-id="${roleId}"]`);
        const icon = btn.querySelector('.btn-icon');
        const text = btn.querySelector('.btn-text');
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';

        if (detail) {
          if (isExpanded) {
            (detail as HTMLElement).classList.add('hidden');
            btn.setAttribute('aria-expanded', 'false');
            if (text) text.textContent = '查看详情';
            if (icon) icon.classList.remove('rotate-180');
          } else {
            (detail as HTMLElement).classList.remove('hidden');
            btn.setAttribute('aria-expanded', 'true');
            if (text) text.textContent = '收起详情';
            if (icon) icon.classList.add('rotate-180');
          }
        }
      });
    });
  }
  initRoleCards();
  document.addEventListener('astro:page-load', initRoleCards);
</script>
