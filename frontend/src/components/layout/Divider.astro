---
/**
 * 板块分隔装饰组件
 * 国潮风格的分隔元素
 * 使用 SVG 祥云纹样作为板块之间的视觉分隔
 */

interface Props {
  /** 装饰样式变体 */
  variant?: 'cloud' | 'wave' | 'simple';
}

const { variant = 'cloud' } = Astro.props;
---

<div class="relative py-6 md:py-8 flex items-center justify-center overflow-hidden">
  {variant === 'cloud' && (
    <div class="flex items-center gap-3 text-gold-300">
      <!-- 左侧装饰 -->
      <svg class="w-8 h-8 md:w-10 md:h-10" viewBox="0 0 40 40" fill="currentColor" opacity="0.5">
        <path d="M10 25c0-3 2-5 5-5 1-3 4-5 7-5 4 0 7 3 7 7 2 0 4 2 4 4s-2 4-4 4H12c-3 0-5-2-5-5z" />
      </svg>
      <!-- 中间分隔点 -->
      <div class="flex gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-china-red-400"></span>
        <span class="w-1.5 h-1.5 rounded-full bg-gold-400"></span>
        <span class="w-1.5 h-1.5 rounded-full bg-china-red-400"></span>
      </div>
      <!-- 右侧装饰 -->
      <svg class="w-8 h-8 md:w-10 md:h-10" viewBox="0 0 40 40" fill="currentColor" opacity="0.5">
        <path d="M10 25c0-3 2-5 5-5 1-3 4-5 7-5 4 0 7 3 7 7 2 0 4 2 4 4s-2 4-4 4H12c-3 0-5-2-5-5z" />
      </svg>
    </div>
  )}

  {variant === 'wave' && (
    <svg class="w-full max-w-md h-4 text-rice-paper-400" viewBox="0 0 200 16" fill="none" stroke="currentColor" stroke-width="1">
      <path d="M0 8 Q25 0 50 8 T100 8 T150 8 T200 8" />
    </svg>
  )}

  {variant === 'simple' && (
    <div class="w-24 h-px bg-gradient-to-r from-transparent via-gold-400 to-transparent"></div>
  )}
</div>
